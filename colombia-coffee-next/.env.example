# ── Zorunlu ──────────────────────────────────────────────
# PostgreSQL bağlantısı (Neon, Supabase, Vercel Postgres ya da kendi sunucun)
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# Yönetim paneli şifresi (/yonetim)
YONETICI_SIFRE="degistir-beni"

# Oturum imzası için uzun rastgele bir metin (ör. `openssl rand -hex 32`)
OTURUM_SIRRI=""

# ── Dosya depolama ───────────────────────────────────────
# Vercel'de: Storage → Blob oluştur; bu değişken otomatik eklenir.
# Boş bırakılırsa dosyalar sunucu diskine (YUKLEME_KLASORU) yazılır — kendi sunucunda (VPS) çalıştırırken.
BLOB_READ_WRITE_TOKEN=""
YUKLEME_KLASORU="./yuklemeler"

# ── Mekan ────────────────────────────────────────────────
MEKAN_ADI="Colombia Coffee"
MEKAN_SLOGAN="Her fincanın bir hikâyesi var"
MEKAN_KONUM=""
MEKAN_INSTAGRAM=""
# Yeni anılar onaylanmadan yayınlanmasın mı? (Panelden de değiştirilebilir)
ONAY_GEREKLI="false"
