# Backend — apps/backend/.env (yerel geliştirme)
# Neon Postgres: https://neon.tech → Connection string
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Üret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cok-gizli-uzun-bir-anahtar"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="bambaska-cok-gizli-uzun-bir-anahtar"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ÖKC adapter (MOCK | BEKO | INGENICO)
OKC_MARKA="MOCK"
