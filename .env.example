# ─────────────────────────────────────────────────────────────
# Rebirth POS — Ortam Değişkenleri (yerel geliştirme)
# Üretim kurulumu için: DEPLOYMENT.md (Vercel + Render + Neon)
# ─────────────────────────────────────────────────────────────

# --- Backend (apps/backend) ---
# Neon Postgres bağlantı dizesi. https://neon.tech → Connection string
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT anahtarları — üret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cok-gizli-uzun-bir-anahtar-uretip-buraya-yaz"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="bambaska-cok-gizli-uzun-bir-anahtar"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
# Birden çok origin virgülle ayrılır. Üretimde Vercel URL'ini ekle.
CORS_ORIGIN="http://localhost:3000"

# ÖKC adapter (MOCK | BEKO | INGENICO)
OKC_MARKA="MOCK"

# --- Frontend (apps/frontend) ---
# Backend API kök adresi (/api dahil). Üretimde Render backend URL'i + /api
NUXT_PUBLIC_API_BASE="http://localhost:3001/api"
