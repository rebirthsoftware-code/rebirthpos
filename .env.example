# ─────────────────────────────────────────────────────────────
# Rebirth POS — Ortam Değişkenleri (yerel geliştirme)
# Üretim kurulumu için: DEPLOYMENT.md (Vercel + Render + Neon)
# ─────────────────────────────────────────────────────────────

# --- Backend (apps/backend) ---
# Neon Postgres bağlantı dizesi. https://neon.tech → Connection string
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT anahtarları — üret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cok-gizli-uzun-bir-anahtar-uretip-buraya-yaz"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="bambaska-cok-gizli-uzun-bir-anahtar"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
# Birden çok origin virgülle ayrılır. Üretimde Vercel URL'ini ekle.
CORS_ORIGIN="http://localhost:3000"

# ÖKC adapter (MOCK | BEKO | INGENICO)
OKC_MARKA="MOCK"

# PayTR Sanal POS (QR menüden masadan online ödeme) adapter (MOCK | PAYTR)
# Entegre bilgileri gelene kadar MOCK kalır — tüm akış test ödeme sayfası üzerinden çalışır.
PAYTR_MARKA="MOCK"
# Gerçek entegrasyon için (PayTR mağaza panelinden alınır) — şimdilik boş bırakılabilir:
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# Ödeme sonrası müşteriyi yönlendirme adresleri (üretimde frontend URL'i):
PAYTR_OK_URL="http://localhost:3000/qr/odeme-test?sonuc=basarili"
PAYTR_FAIL_URL="http://localhost:3000/qr/odeme-test?sonuc=basarisiz"

# --- Frontend (apps/frontend) ---
# Backend API kök adresi (/api dahil). Üretimde Render backend URL'i + /api
NUXT_PUBLIC_API_BASE="http://localhost:3001/api"
